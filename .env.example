# JARVIS local development environment
APP_ENV=development
APP_NAME="JARVIS AI OS"
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security and client access
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-in-production-with-32-plus-chars
JWT_ISSUER=jarvis-ai-os
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCESS_COOKIE_NAME=jarvis_access_token
REFRESH_COOKIE_NAME=jarvis_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Memory Engine
SHORT_TERM_MEMORY_DEFAULT_TTL_HOURS=24

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_password
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@postgres:5432/jarvis

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=jarvis
CHROMA_DOCUMENTS_COLLECTION=documents

# RAG Knowledge Engine
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=180

# Agent orchestration
LANGGRAPH_ENV=development
AGENT_DEFAULT_RECURSION_LIMIT=25

# Frontend
VITE_API_BASE_URL=http://localhost:8000
