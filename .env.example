# JARVIS Phase 1 environment
APP_ENV=development
APP_NAME="JARVIS AI OS"
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security and client access
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_password
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@postgres:5432/jarvis

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=jarvis

# Agent orchestration
LANGGRAPH_ENV=development
AGENT_DEFAULT_RECURSION_LIMIT=25

# Frontend
VITE_API_BASE_URL=http://localhost:8000
